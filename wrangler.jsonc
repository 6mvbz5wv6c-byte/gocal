{
  "name": "findout",
  "main": "server/worker.js",
  "compatibility_date": "2026-05-22",
  "account_id": "0e675f94009c81e7559ae23cd6706376",
  "workers_dev": true,
  "assets": {
    "directory": "./docs",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "findout-production",
      "database_id": "a10bd1ba-1b3e-4ae1-9638-a43dbe24d9fb",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": [
      "15 8 * * *"
    ]
  },
  "observability": {
    "enabled": false
  },
  "routes": [
    {
      "pattern": "findout.events",
      "custom_domain": true,
      "zone_id": "660590c316924ea92a76c1890b0d84d8"
    },
    {
      "pattern": "www.findout.events",
      "custom_domain": true,
      "zone_id": "660590c316924ea92a76c1890b0d84d8"
    }
  ],
  "ratelimits": [
    {
      "name": "PUBLIC_WRITE_BURST",
      "namespace_id": "7270101",
      "simple": {
        "limit": 3,
        "period": 60
      }
    },
    {
      "name": "API_READ_BURST",
      "namespace_id": "7270102",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "API_WRITE_BURST",
      "namespace_id": "7270103",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ]
}
